# hsemail-tracker environment
# Copy to /opt/hsemail-tracker/.env on the server (chmod 600).

# MUST be the exact same value as TRACKING_SECRET in the main app's .env.
# Do NOT rotate or regenerate — the 96 already-delivered emails carry tokens
# signed with the current secret.
TRACKING_SECRET=

# Same Postgres database as the main app (used only to record click/open
# analytics and to process unsubscribes). Redirects still work without it.
DATABASE_URL=postgres://user:password@127.0.0.1:2870/postgres

# Local bind — nginx proxies to this. Never expose directly.
HOST=127.0.0.1
PORT=8090

# Set to "require" only if your Postgres requires TLS.
# PGSSL=require
